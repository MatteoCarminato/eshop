# WhatsApp
WWEBJS_CACHE_TYPE=local

# API
PORT=3000
API_KEY=mude-esta-chave-secreta

# Modo de envio: csv | whatsapp | label (por etiqueta do WPP Business)
SEND_MODE=csv

# Nome da etiqueta para envio (usado quando SEND_MODE=label)
# Ex: Casa, Terreno
SEND_LABEL=

# Caminho do CSV de contatos (usado quando SEND_MODE=csv)
CONTACTS_CSV_PATH=data/contacts.csv

# Envio
MIN_DELAY_MS=30000
MAX_DELAY_MS=60000
MAX_MESSAGES_PER_SESSION=100
PAUSE_AFTER_MESSAGES=20
PAUSE_DURATION_MS=300000

# Imagem
DEFAULT_IMAGE_PATH=media/oferta.jpg

# Webhook para Laravel (Inbox / Tempo Real)
WEBHOOK_URL=
WEBHOOK_SECRET=
INSTANCE_ID=0
ENABLE_MESSAGE_FORWARDING=false

# Logs
LOG_LEVEL=info
