APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=eshop

VITE_APP_NAME="${APP_NAME}"

# ── WhatsApp — Instância Disparador (porta 3000) ─────────────────────────────
WHATSAPP_NODE_URL=http://127.0.0.1:3000
WHATSAPP_NODE_API_KEY=
WHATSAPP_NODE_TIMEOUT=10
WHATSAPP_WEBHOOK_TOKEN=

# ── WhatsApp — Instância Grupos PIX (porta 3001) ─────────────────────────────
WHATSAPP_NODE_GRUPOS_URL=http://127.0.0.1:3001
WHATSAPP_NODE_GRUPOS_API_KEY=
WHATSAPP_NODE_GRUPOS_TIMEOUT=10

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# ── ClientBank / Spacedati ────────────────────────────────────────────────────
CLIENTBANK_URL=https://client-bank.spacedati.com
CLIENTBANK_NAME=
CLIENTBANK_PASSWORD=

# ── ERP Consoft (MySQL, somente leitura) — sincronização de Produto/Marca ─────
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=3306
ERP_DB_DATABASE=
ERP_DB_USERNAME=
ERP_DB_PASSWORD=
ERP_DB_CHARSET=utf8mb4

# ── ERP Consoft (MySQL, ESCRITA) — preço de atacado da grade Produtos × Preços ─
# Usuário separado do de leitura: só grava PREATAC/PREVEN/PREMIN/PRECOWEB na
# PRODUTO_PRO, casando a linha por CODNNN. ERP_PRICE_WRITE=false deixa a grade
# gravando só na base do site (é o padrão dos testes).
ERP_UPDATE_DB_HOST=
ERP_UPDATE_DB_PORT=3306
ERP_UPDATE_DB_DATABASE=novo_cec
ERP_UPDATE_DB_USERNAME=
ERP_UPDATE_DB_PASSWORD=
ERP_UPDATE_TIMEOUT=8
ERP_PRICE_WRITE=false

# ── API pública para o frontend Orbita (Next.js) ───────────────────────────────
ORBITA_API_TOKEN=
# Revalidação de cache do Orbita: URL da rota /api/revalidate do Next.js e o
# segredo compartilhado com ela (REVALIDATE_SECRET no .env.local do Orbita).
# Vazio = o aviso não é enviado e o cache do site só vence pelo tempo.
ORBITA_REVALIDATE_URL=
ORBITA_REVALIDATE_SECRET=

# ── ComprasPY ─────────────────────────────────────────────────────────────────
# Feed XML (já em produção): domínio da LOJA, usado nos links do feed.
COMPRASPY_STORE_URL=https://eshopcell.com

# API de importação (POST /api/products/import/): salvar o Preço Web na grade
# empurra o produto pro ComprasPY na hora. Vazio = envio desligado, vale só o
# XML. Preencha UMA SÓ das credenciais: o `token` da loja (header `token`, que
# é o caso do UUID que eles entregam) OU um JWT (Authorization: Bearer). As
# duas juntas = 401: o middleware de JWT recusa o UUID antes de olhar o header
# `token`. Ver docs/ComprasPy-Feed.md.
COMPRASPY_API_URL=https://products.comprasparaguai.com.br/api/products/import/
COMPRASPY_API_TOKEN=
COMPRASPY_API_BEARER=
COMPRASPY_API_TIMEOUT=15
# url_image é obrigatória lá: com uma URL aqui, produto sem foto é anunciado
# com essa imagem genérica; vazio, ele é pulado e fica só no XML.
COMPRASPY_API_FALLBACK_IMAGE=
COMPRASPY_API_FORCE_IMAGE_UPDATE=false
